# Root environment example - copy to .env and configure

# Database
DATABASE_URL=postgresql://wealthhabit:wealthhabit@localhost:5433/wealthhabit

# Backend
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Reverse proxy trust (Express `app.set('trust proxy')`).
# Default: false. Unset and false are equivalent - X-Forwarded-For is ignored
# and req.ip always comes from the TCP socket.
# NEVER set this to true: permissive trust lets any client forge X-Forwarded-For
# and rotate its own rate-limit key. Literal "true" is rejected at startup.
# Numeric values are trusted proxy hops (e.g. 1 = one reverse proxy in front of
# the app). Symbolic/CIDR lists are also accepted (e.g. loopback,10.0.0.0/8).
# The value MUST match the real deployment topology. When a hop count is used,
# direct client access to the application must be prevented so only the proxy
# can reach it - otherwise a client can forge its own X-Forwarded-For entry.
# Leave unset until the deployment topology is known.
# TRUST_PROXY=false

# Frontend
VITE_API_BASE_URL=http://localhost:5000/api