# WealthHabit API — PRODUCTION runtime environment (example only).
#
# Copy to server/.env.production and inject the values through your deployment
# mechanism (docker compose -f docker-compose.production.yml, an orchestrator
# secret, a systemd EnvironmentFile, ...). server/.env.production is covered by
# the .gitignore ".env.*" rule: only this *.example file is ever tracked.
# Never commit a filled-in copy and never reuse a development value here.
#
# Development/test equivalents live in server/.env.example; tests derive their
# own database target (server/scripts/lib/dbSafety.ts) and never read this file.

# --- Required, externally supplied ------------------------------------------

# Must be production. It switches on the production-only guards in
# server/src/config/index.ts: JWT secret validation at start-up, forced secure
# cookies, HSTS + upgrade-insecure-requests security headers, combined logging.
NODE_ENV=production

# Database. Externally hosted (managed PostgreSQL / RDS) and supplied by the
# operator — never the local docker-compose PostgreSQL (localhost:5433) and
# never a development credential. No migration runs when the container starts;
# apply schema changes out of band (see README, "Production containers").
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE-HOST:5432/wealthhabit

# JWT signing secret. Must be at least 32 characters and must not be the
# development default; the server refuses to start in production otherwise.
# Generate one per environment and inject it from a secret store.
#
# The value below is a placeholder and the server DELIBERATELY refuses to start
# in production while it is unchanged, because this file is public in the
# repository: shipping it would mean signing production tokens with publicly
# known material. Replace it, for example with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-from-a-secret-store

# Real deployed frontend origin (scheme + host + port the browser uses).
# Drives CORS for credentialed requests; a mismatch breaks login/refresh.
CLIENT_URL=https://app.example.com

# --- Process ----------------------------------------------------------------

# Container listens on this port (the server image exposes 5000).
PORT=5000

# --- Refresh cookie ---------------------------------------------------------

# Production forces COOKIE_SECURE=true even when this is unset or false
# (server/src/config/index.ts), so the refresh cookie is never sent over plain
# HTTP. Set it explicitly anyway to document intent: TLS must terminate in
# front of the app or the refresh flow cannot work.
COOKIE_SECURE=true

# lax (default), strict, or none. "none" additionally requires
# COOKIE_SECURE=true and only makes sense for a cross-origin frontend; the
# supported deployment is same-origin, which keeps "lax".
COOKIE_SAME_SITE=lax
COOKIE_NAME=wh_refresh_token

# Refresh token lifetime in days; access tokens stay short-lived.
REFRESH_TOKEN_EXPIRES_DAYS=30
JWT_ACCESS_EXPIRES_IN=15m

# --- Email verification ------------------------------------------------------

# There is no real mail provider wired in yet. Registration and resend both
# succeed, but without a transport nothing reaches a real mailbox. Choose one
# before enabling verification for real users:
#
#   1. EMAIL_TRANSPORT=webhook plus EMAIL_WEBHOOK_URL/EMAIL_WEBHOOK_TOKEN, pointed
#      at an operator-run mailer that forwards the JSON payload. No new SDK
#      dependency, and the token stays inside your own infrastructure.
#   2. Add a native transport (SES/Postmark/Resend) to
#      server/src/services/emailService.ts and select it here.
#
# The default `memory` transport delivers nothing and logs a warning at start-up
# when NODE_ENV=production, which is the intended reminder that this is not done.
EMAIL_TRANSPORT=webhook
EMAIL_FROM=WealthHabit <no-reply@example.com>
EMAIL_WEBHOOK_URL=https://mailer.example.com/inbound
EMAIL_WEBHOOK_TOKEN=replace-with-a-secret-from-your-secret-store
# Single-use link lifetime (minutes) and per-account resend cooldown (seconds).
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# --- Reverse proxy trust (topology dependent) -------------------------------

# Exactly ONE proxy hop sits in front of this API in the shipped production
# topology: the client nginx container forwards /api/* to the server container
# (see docker-compose.production.yml and client/nginx/default.conf.template).
# The API port is internal-only and never published, so the API is never
# reached directly by a browser.
#
# Therefore the correct value for the shipped topology is 1. With this value
# Express reads the client address from X-Forwarded-For as set by that single
# trusted nginx hop, so the rate limiters in server/src/middleware/rateLimit.ts
# key per real client IP. Setting a lower value here (for example false) makes
# every request look like it came from the nginx container address, which
# collapses authRateLimit/apiRateLimit into one shared bucket for all users and
# removes the IP dimension of loginRateLimit.
#
# NEVER set the literal value "true": it is rejected at start-up and falls back
# to false, because permissive trust lets any client forge X-Forwarded-For and
# rotate its own rate-limit key.
#
# If you change the topology, change this to match, and no further. Use the
# exact number of hops in front of the API (e.g. 2 when a load balancer sits in
# front of the nginx container), or a proxy-addr address/CIDR/symbolic range.
# The value MUST match the real topology.
TRUST_PROXY=1

# --- Deliberately absent ----------------------------------------------------
# * No development DATABASE_URL / localhost:5433 value.
# * No development JWT secret and no development CLIENT_URL.
# * No VITE_* variables: those are client build-time values and are visible to
#   the browser (see client/.env.production.example).
