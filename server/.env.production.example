# WealthHabit API — PRODUCTION runtime environment (example only).
#
# Copy to server/.env.production and inject the values through your deployment
# mechanism (docker compose -f docker-compose.production.yml, an orchestrator
# secret, a systemd EnvironmentFile, ...). server/.env.production is covered by
# the .gitignore ".env.*" rule: only this *.example file is ever tracked.
# Never commit a filled-in copy and never reuse a development value here.
#
# Development/test equivalents live in server/.env.example; tests derive their
# own database target (server/scripts/lib/dbSafety.ts) and never read this file.

# --- Required, externally supplied ------------------------------------------

# Must be production. It switches on the production-only guards in
# server/src/config/index.ts: JWT secret validation at start-up, forced secure
# cookies, HSTS + upgrade-insecure-requests security headers, combined logging.
NODE_ENV=production

# Database. Externally hosted (managed PostgreSQL / RDS) and supplied by the
# operator — never the local docker-compose PostgreSQL (localhost:5433) and
# never a development credential. No migration runs when the container starts;
# apply schema changes out of band (see README, "Production containers").
DATABASE_URL=postgresql://USER:PASSWORD@DATABASE-HOST:5432/wealthhabit

# JWT signing secret. Must be at least 32 characters and must not be the
# development default; the server refuses to start in production otherwise.
# Generate one per environment and inject it from a secret store.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-from-a-secret-store

# Real deployed frontend origin (scheme + host + port the browser uses).
# Drives CORS for credentialed requests; a mismatch breaks login/refresh.
CLIENT_URL=https://app.example.com

# --- Process ----------------------------------------------------------------

# Container listens on this port (the server image exposes 5000).
PORT=5000

# --- Refresh cookie ---------------------------------------------------------

# Production forces COOKIE_SECURE=true even when this is unset or false
# (server/src/config/index.ts), so the refresh cookie is never sent over plain
# HTTP. Set it explicitly anyway to document intent: TLS must terminate in
# front of the app or the refresh flow cannot work.
COOKIE_SECURE=true

# lax (default), strict, or none. "none" additionally requires
# COOKIE_SECURE=true and only makes sense for a cross-origin frontend; the
# supported deployment is same-origin, which keeps "lax".
COOKIE_SAME_SITE=lax
COOKIE_NAME=wh_refresh_token

# Refresh token lifetime in days; access tokens stay short-lived.
REFRESH_TOKEN_EXPIRES_DAYS=30
JWT_ACCESS_EXPIRES_IN=15m

# --- Reverse proxy trust (topology dependent) -------------------------------

# NEVER true: the literal value "true" is rejected at start-up and falls back
# to false. Leave unset or false when the app is reached directly; set the
# number of proxy hops in front of it (e.g. 1 when only the client nginx or a
# single load balancer proxies to the API). The value MUST match the real
# topology, otherwise X-Forwarded-For is trusted incorrectly and rate-limit
# keys become forgeable. Wrong is worse than absent: default to false until the
# topology is known.
TRUST_PROXY=false

# --- Deliberately absent ----------------------------------------------------
# * No development DATABASE_URL / localhost:5433 value.
# * No development JWT secret and no development CLIENT_URL.
# * No VITE_* variables: those are client build-time values and are visible to
#   the browser (see client/.env.production.example).
