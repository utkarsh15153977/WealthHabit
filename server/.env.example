# Server environment example - copy to .env and configure
#
# DEVELOPMENT / LOCAL configuration only. Production runtime variables are
# documented separately in server/.env.production.example (required values,
# secret injection, cookie and TRUST_PROXY expectations). Tests never read a
# production file: they set NODE_ENV=test and derive a localhost *_test
# database through server/scripts/lib/dbSafety.ts.

PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://wealthhabit:wealthhabit@localhost:5433/wealthhabit
CLIENT_URL=http://localhost:5173

# Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_NAME=wh_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Reverse proxy trust (Express `app.set('trust proxy')`)
# Default: false - unset and false behave identically: X-Forwarded-For is
# ignored and req.ip always comes from the TCP socket.
# NEVER use true. Permissive trust lets any client forge X-Forwarded-For and
# rotate its own rate-limit key; the literal value "true" is rejected and the
# setting falls back to false.
# Numeric values represent trusted proxy hops (1 = exactly one reverse proxy
# or load balancer in front of the app). Symbolic ranges and CIDR lists are
# accepted too (loopback, linklocal, uniquelocal, 10.0.0.0/8).
# The configured value MUST match the real deployment topology. With a numeric
# hop count, direct client access to the application must be prevented so that
# only the proxy can reach it; otherwise a client can forge its own
# X-Forwarded-For entry and bypass IP rate limiting.
# Invalid values fail closed to false with a startup warning.
# Leave this unset until the deployment topology is known.
# TRUST_PROXY=false

# Testing (optional)
# Test database resolution order (server/scripts/lib/dbSafety.ts):
#   1. TEST_DATABASE_URL (if set)
#   2. derived from DATABASE_URL, but only when DATABASE_URL points at localhost
#      (database name gets "_test" appended, e.g. .../wealthhabit -> .../wealthhabit_test)
#   3. safe local default: postgresql://localhost:5433/wealthhabit_test
# A remote/production DATABASE_URL is never used to derive the test database.
# TEST_DATABASE_URL=postgresql://wealthhabit:wealthhabit@localhost:5433/wealthhabit_test
#
# Database safety guard (server/scripts/lib/dbSafety.ts):
# - Automated tests require NODE_ENV=test, a database name ending in "_test",
#   a local host, and never AWS-hosted endpoints.
# - Opt in to a non-local, non-AWS *_test database for tests only when unavoidable:
# ALLOW_REMOTE_TEST_DB=1
# - E2E scripts (npm run e2e:*) accept localhost *_test databases automatically;
#   any other target (including the local dev database "wealthhabit") needs an
#   explicit opt-in, and the production database name is never allowed on a
#   remote host:
# E2E_ALLOW_DB=1