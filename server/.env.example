# Server environment example - copy to .env and configure

PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://wealthhabit:wealthhabit@localhost:5433/wealthhabit
CLIENT_URL=http://localhost:5173

# Authentication
JWT_ACCESS_SECRET=your-super-secret-jwt-access-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
COOKIE_NAME=wh_refresh_token
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Testing (optional)
# Tests derive their database from DATABASE_URL by appending "_test"
# (e.g. .../wealthhabit -> .../wealthhabit_test). Set this to override.
# TEST_DATABASE_URL=postgresql://wealthhabit:wealthhabit@localhost:5433/wealthhabit_test