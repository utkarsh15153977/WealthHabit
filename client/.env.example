# Client environment example - copy to .env and configure
#
# DEVELOPMENT configuration for the Vite dev server (and a local `npm run
# build`). VITE_* values are BUILD-TIME only: Vite inlines them into the
# bundle, so they are visible in the browser and must never be secrets.
# The production container build documents them in
# client/.env.production.example (build arg --build-arg VITE_API_BASE_URL=...).

VITE_API_BASE_URL=http://localhost:5000/api